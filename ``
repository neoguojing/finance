import json
import os
from typing import Dict, Any, Optional
from pydantic import BaseModel, Field

class AshareConfig(BaseModel):
    pe_weight: float
    pb_weight: float
    erp_weight: float
    market_score_value_weight: float
    market_score_drawdown_weight: float
    multiplier_base: float
    multiplier_factor: float

class USshareConfig(BaseModel):
    forward_pe_weight: float
    peg_weight: float
    drawdown_weight: float
    us_score_growth_weight: float
    us_score_vix_weight: float
    us_score_rate_weight: float
    multiplier_base: float
    multiplier_factor: float

class CommonConfig(BaseModel):
    max_investment_percent: float
    cash_safety_factors: list[Dict[str, Any]] = Field(default_factory=list)

class ConfigLoader:
    """
    配置加载器：负责从 data/ 目录下的 JSON 文件中加载参数，并进行验证。
    """
    def __init__(self, data_dir: str = "data"):
        self.data_dir = data_dir
        self.ashare_config: Optional[AshareConfig] = None
        self.usshare_config: Optional[USshareConfig] = None
        self.common_config: Optional[CommonConfig] = None
        self._load_all()

    def _load_json(self, filename: str) -> dict:
        path = os.path.join(self.data_dir, filename)
        if not os.path.exists(path):
            print(f"Warning: Config file {path} not found.")
            return {}
        try:
            with open(path, 'r', encoding='utf-8') as f:
                return json.load(f)
        except Exception as e:
            print(f"Error loading {path}: {e}")
            return {}

    def _load_all(self):
        # Load common config
        common_data = self._load_json("common_params.json")
        if common_data:
            self.common_config = CommonConfig(**common_data)

        # Load ashare config
        ashare_data = self._load_json("ashare_params.json")
        if ashare_data:
            self.ashare_config = AshareConfig(**ashare_data)

        # Load usshare config
        usshare_data = self._load_json("usshare_params.json")
        if usshare_data:
            self.usshare_config = USshareConfig(**usshare_data)

    def get_ashare_config(self) -> AshareConfig:
        if not self.ashare_config:
            raise ValueError("Ashare configuration not loaded.")
        return self.ashare_config

    def get_usshare_config(self) -> USshareConfig:
        if not self.usshare_config:
            raise ValueError("USshare configuration not loaded.")
        return self.usshare_config

    def get_common_config(self) -> CommonConfig:
        if not self.common_config:
            raise ValueError("Common configuration not loaded.")
        return self.common_config
